rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAtendenteOrAdmin() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        (request.auth.token.email == 'admin@segurabot.com.br' || 
         request.auth.token.email == 'atendente@segurabot.com.br');
    }

    function isAtendenteOrAdminToken() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        (request.auth.token.email == 'admin@segurabot.com.br' || 
         request.auth.token.email == 'atendente@segurabot.com.br');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Collection group rule for omnichannel operator queue
    match /{path=**}/chat_sessions/{sessionId} {
      allow read, update: if isAtendenteOrAdminToken();
    }

    // Chat sessions
    match /users/{userId}/chat_sessions/{sessionId} {
      allow read: if isOwner(userId) || isAtendenteOrAdminToken() || userId.matches('^visitor-.*');
      allow create: if isOwner(userId) || isAtendenteOrAdminToken() || userId.matches('^visitor-.*');
      allow update: if isOwner(userId) || isAtendenteOrAdminToken() || userId.matches('^visitor-.*');
      allow delete: if isOwner(userId) || isAtendenteOrAdminToken();

      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isOwner(userId) || isAtendenteOrAdminToken() || userId.matches('^visitor-.*');
        allow create: if isOwner(userId) || isAtendenteOrAdminToken() || userId.matches('^visitor-.*');
        allow update: if isOwner(userId) || isAtendenteOrAdminToken() || userId.matches('^visitor-.*');
        allow delete: if isOwner(userId) || isAtendenteOrAdminToken();
      }
    }

    // Knowledge Base - Read for signed-in users, write for atendentes/admins
    match /knowledge_base/{entryId} {
      allow read: if isSignedIn() || request.auth == null; // Allow unauthenticated landing visitors to read FAQs
      allow write: if isAtendenteOrAdmin();
    }

    // Knowledge Sources - Read for signed-in users, write for atendentes/admins
    match /knowledge_sources/{sourceId} {
      allow read: if isSignedIn() || request.auth == null; // Allow unauthenticated landing visitors to read sources
      allow write: if isAtendenteOrAdmin();
    }

    // Customers - Users can only read/write their own profile
    match /customers/{customerId} {
      allow read: if (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)) || customerId.matches('^visitor-.*') || customerId == 'visitor';
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid && customerId == request.auth.uid) || customerId.matches('^visitor-.*') || customerId == 'visitor';
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || customerId.matches('^visitor-.*') || customerId == 'visitor';
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Support Tickets - Users can only read/write their own tickets
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAtendenteOrAdminToken());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAtendenteOrAdminToken());
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAtendenteOrAdminToken());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAtendenteOrAdminToken());
    }

    // Analytics Events Tracking
    match /analytics/{eventId} {
      allow create: if true; // Anonymous visitors can track events
      allow read: if isAtendenteOrAdmin(); // Only operators/admins can view dashboard stats
      allow update, delete: if false; // Historical logs are immutable
    }

    // Global Settings (e.g., IA Config) - Public read, Admin/Atendente write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAtendenteOrAdmin();
    }
  }
}
